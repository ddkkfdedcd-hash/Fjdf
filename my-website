<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>پاشبنمای دەگمەن و ئەستێرەیی</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body, html {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #020617;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  /* پاشبنمای تیشکۆیی جووڵاو */
  .wallpaper-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
  }

  .glow-orb {
    position: absolute;
    width: 350px;
    height: 350px;
    background: linear-gradient(45deg, rgba(56, 189, 248, 0.15), rgba(244, 63, 94, 0.15));
    border-radius: 50%;
    filter: blur(80px);
    animation: floatOrb 8s ease-in-out infinite alternate;
  }

  @keyframes floatOrb {
    0% { transform: scale(1) translate(-30px, -20px); }
    100% { transform: scale(1.3) translate(40px, 30px); }
  }

  .glass-card {
    position: relative;
    z-index: 10;
    width: min(90%, 420px);
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    padding: 35px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.9), inset 0 0 20px rgba(56, 189, 248, 0.1);
    text-align: center;
  }

  h1 {
    font-size: 24px;
    font-weight: 800;
    background: linear-gradient(45deg, #38bdf8, #818cf8, #f43f5e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 15px;
    letter-spacing: 1px;
  }

  p {
    font-size: 14px;
    color: #94a3b8;
    line-height: 1.8;
    margin-bottom: 25px;
  }

  .live-stats {
    display: flex;
    justify-content: space-around;
    background: rgba(2, 6, 23, 0.5);
    border-radius: 16px;
    padding: 15px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .stat-item span {
    display: block;
  }

  .stat-value {
    font-size: 18px;
    font-weight: bold;
    color: #38bdf8;
  }

  .stat-label {
    font-size: 11px;
    color: #64748b;
    margin-top: 4px;
  }

  /* کاتژمێری ڕاستەقینە بۆ پاشبنما */
  .clock {
    margin-top: 25px;
    font-size: 32px;
    font-weight: bold;
    color: #f8fafc;
    text-shadow: 0 0 20px rgba(56, 189, 248, 0.5);
    font-family: monospace;
  }
</style>
</head>
<body>

<div class="wallpaper-container">
  <div class="glow-orb"></div>

  <div class="glass-card">
    <h1>✨ لایڤ وۆڵپەبەری دەگمەن ✨</h1>
    <p>ئەمە وەک پاشبنمایەکی زیندوو و هۆلۆگرافی کار دەکات کە هەمیشە لە بزاوتدایە و جوانییەکی بێوێنە دەبەخشێت.</p>

    <div class="live-stats">
      <div class="stat-item">
        <span class="stat-value" id="fpsCounter">60</span>
        <span class="stat-label">حاڵەتی هۆلۆگرافی</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">ئارام</span>
        <span class="stat-label">ژینگە</span>
      </div>
    </div>

    <div class="clock" id="liveClock">00:00:00</div>
  </div>
</div>

<script>
  // کاتژمێری زیندوو بۆ ناو وۆڵپەبەرەکە
  setInterval(() => {
    const now = new Date();
    const timeString = now.toTimeString().split(' ')[0];
    document.getElementById('liveClock').innerText = timeString;
  }, 1000);
</script>

</body>
</html>
